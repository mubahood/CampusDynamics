SELECT l.voucherNo, ROUND(SUM(CASE WHEN l.transactionType='DR' THEN l.transaction_amount ELSE 0 END)) dr, ROUND(SUM(CASE WHEN l.transactionType='CR' THEN l.transaction_amount ELSE 0 END)) cr, COALESCE(j.PostStatus,'ORPHAN') st FROM fin_ledger l LEFT JOIN fin_journalnumbers j ON j.GL_VoucherNo=l.voucherNo WHERE l.voucherNo NOT IN (SELECT voucherNo FROM fin_repair_log WHERE action_taken='VOIDED_E6') GROUP BY l.voucherNo HAVING ABS(dr-cr) 
