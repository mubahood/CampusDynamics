<head id="Head1" runat="server">
  <title>Campus Dynamics ERP :: Higher Education ERP Solution</title>
  <meta name="description" content="website description" />
  <meta name="keywords" content="Academica ERP OPAC" />
  <meta http-equiv="content-type" content="text/html; charset=utf-8" />
  <link rel="stylesheet" type="text/css" href="~/COOPERP/css/style.css" />
  <link rel="shortcut icon" href="~/COOPERP/images/tinylogo.gif" />
    <style type="text/css">
        .style1
        {
            width: 100%;
        }
        .style2
        {
            width: 300px;
            background-image: url('..images/header_1_backgrimg.png');
        }
        .backImg
        {
            background-image: url('../images/header_1_backgrimg.png');
        }

    .options
    {
        height: 20px;
        width: 150px;
    }
      


        </style>
</head>
<body>
    <form id="form1" runat="server">
    <div id="main">
        <header>
	    <!--close banner-->	
	</header>
	
	<nav>
	  <div id="menubar">
        
	      <asp:ScriptManager ID="ScriptManager1" runat="server">
          </asp:ScriptManager>
        
      </div><!--close menubar-->	
    </nav>	
    
	<div id="site_content">			
	
	    <table class="style1">
            <tr>
                <td align="right">
                <table cellspacing="0" class="style1" cellpadding="0">
                    <tr class="backImg">
                        <td class="style2" align="left">
                            <img src="../images/header_1_leftimg.png" alt="School Dynamics Version 1.0"/></td>
                        <td class="backImg">
                           </td>
                        <td align="right" class="style2">
                            <img src="../images/header_1_rightimg.png" alt="" /></td>
                    </tr>
                </table>
                </td>
            </tr>
            <tr>
                <td align="right">
        
          <dx:ASPxMenu ID="ASPxMenu1" runat="server" Width="100%" ItemImagePosition="Top">
              <Items>
                  <dx:MenuItem Name="Dashboard" Text="Dashboard"
                      NavigateUrl="~/COOPERP/accounts/AccountingCenter.aspx">
                      <Image Url="~/COOPERP/images/application-icon.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Transactions">
                      <Items>
                          <dx:MenuItem Text="Vouchers Centre"
                              NavigateUrl="~/COOPERP/accounts/AccountingCenter.aspx?pid=4">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Payment Vouchers"
                              NavigateUrl="~/COOPERP/accounts/AccountingCenter.aspx?pid=4&amp;j=Payment">
                              <Image Url="~/COOPERP/images/money-coin.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/accounts/AccountLedger.aspx"
                              Text="Account Ledgers">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/accounts/BudgetManager.aspx" Text="Budget Management">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/clipboard-invoice.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Ledgers &amp; Reports">
                      <Items>
                          <dx:MenuItem NavigateUrl="~/COOPERP/accounts/GLDrillDown.aspx" Text="General Ledger">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Cash Book"
                              NavigateUrl="~/COOPERP/accounts/CashBook.aspx">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Bank Reconciliation"
                              NavigateUrl="~/COOPERP/accounts/BankReconciliation.aspx">
                              <Image Url="~/COOPERP/images/clipboard--pencil.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Financial Documents"
                              NavigateUrl="~/COOPERP/accounts/AccountingCenter.aspx?pid=7">
                              <Image Url="~/COOPERP/images/reports-stack.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/accounts/AccountingCenter.aspx?pid=8" Text="Escalated Transactions">
                              <Image Url="~/COOPERP/images/sticky-notes-pin.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/tick-button.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="* Finance Realignment Admin"
                      NavigateUrl="~/COOPERP/Finance/Admin/TransactionBatchMonitor.aspx">
                      <Image Url="~/COOPERP/images/clipboard-list.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Finance System Realignment">
                      <Items>
                          <dx:MenuItem Text="* Transaction Batch Monitor"
                              NavigateUrl="~/COOPERP/Finance/Admin/TransactionBatchMonitor.aspx">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Double-Entry Validation"
                              NavigateUrl="~/COOPERP/Finance/Admin/DoubleEntryValidation.aspx">
                              <Image Url="~/COOPERP/images/tick-button.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Accounting Period Management"
                              NavigateUrl="~/COOPERP/Finance/Admin/PeriodManagement.aspx">
                              <Image Url="~/COOPERP/images/clipboard-list.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Reversal and Correction Approvals"
                              NavigateUrl="~/COOPERP/Finance/Admin/ReversalApprovals.aspx">
                              <Image Url="~/COOPERP/images/clipboard--pencil.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Transaction Audit Trail"
                              NavigateUrl="~/COOPERP/Finance/Admin/TransactionAuditTrail.aspx">
                              <Image Url="~/COOPERP/images/reports-stack.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Bank Reconciliation Import Validation"
                              NavigateUrl="~/COOPERP/Finance/Admin/BankReconciliationImport.aspx">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Chart of Accounts Lifecycle Management"
                              NavigateUrl="~/COOPERP/Finance/Admin/AccountManagement.aspx">
                              <Image Url="~/COOPERP/images/hammer-screwdriver.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Period Close Management"
                              NavigateUrl="~/COOPERP/Finance/Admin/PeriodClose.aspx">
                              <Image Url="~/COOPERP/images/sticky-notes-pin.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Initiate Reversal Request"
                              NavigateUrl="~/COOPERP/Finance/Admin/ReversalRequest.aspx">
                              <Image Url="~/COOPERP/images/clipboard--pencil.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Bank Reconciliation Matching"
                              NavigateUrl="~/COOPERP/Finance/Admin/BankRecoMatching.aspx">
                              <Image Url="~/COOPERP/images/reports-stack.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="* Initiate Correction Request"
                              NavigateUrl="~/COOPERP/Finance/Admin/CorrectionRequest.aspx">
                              <Image Url="~/COOPERP/images/clipboard--pencil.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/clipboard-list.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Settings">
                      <Items>
                          <dx:MenuItem Text="Company Information" NavigateUrl="~/COOPERP/accounts/CompanyInfo.aspx">
                              <Image Url="~/COOPERP/images/clipboard-list.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/accounts/Default.aspx" Text="Chart of Accounts">
                              <Image Url="~/COOPERP/images/clipboard-list.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/accounts/AccountingPeriod.aspx" Text="Accounting Periods">
                              <Image IconID="scheduling_switchtimescalesto_16x16">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/hammer-screwdriver.png">
                      </Image>
                  </dx:MenuItem>
              </Items>
              <SubMenuItemStyle>
                  <Paddings Padding="10px" />
              </SubMenuItemStyle>
          </dx:ASPxMenu>
        
                </td>
            </tr>
            <tr>
                <td>
                    <div style="background:#e8f4fd;border-bottom:1px solid #bee5f5;padding:5px 10px;display:flex;align-items:center;gap:8px;font-size:12px;">
                        <span style="color:#05275C;font-weight:600;white-space:nowrap;">&#128269; Search Transactions:</span>
                        <input id="txnSearchBox" type="text" placeholder="Voucher no, account code, or descriptionâ€¦"
                            style="flex:1;max-width:400px;padding:4px 8px;border:1px solid #bee5f5;border-radius:3px;font-size:12px;"
                            onkeydown="if(event.key==='Enter'){cdTxnSearch();}" />
                        <input type="button" value="Search" onclick="cdTxnSearch();"
                            style="padding:4px 14px;background:#05275C;color:#fff;border:none;border-radius:3px;font-size:12px;cursor:pointer;" />
                    </div>
                    <dx:ASPxPopupControl ID="pop_txnSearch" runat="server" ClientInstanceName="pop_txnSearch"
                        HeaderText="Transaction Search Results" Modal="True" CloseAction="CloseButton"
                        PopupHorizontalAlign="WindowCenter" PopupVerticalAlign="WindowCenter"
                        Width="860px" Height="480px">
                    </dx:ASPxPopupControl>
                    <script type="text/javascript">
                        function cdTxnSearch() {
                            var q = encodeURIComponent(document.getElementById('txnSearchBox').value || '');
                            if (!q) return;
                            pop_txnSearch.SetContentUrl('TxnSearch.aspx?q=' + q);
                            pop_txnSearch.Show();
                        }
                    </script>
                </td>
            </tr>
            <tr>
                <td align="right">
                                                            <table cellspacing="1" class="style1">
                                                                <tr>
                                                                    <td style="text-align: left">
                                                            <dx:ASPxLabel ID="lbl_date" runat="server" ForeColor="Red">
                                                            </dx:ASPxLabel>
                                                                    </td>
                                                                    <td align="right">
                                                                        <dx:ASPxImage ID="ASPxImage2" runat="server" ImageAlign="AbsBottom" ImageUrl="~/COOPERP/images/user.png">
                                                            </dx:ASPxImage>
&nbsp;<dx:ASPxLabel ID="ASPxLabel1" runat="server" Text="Current User:">
                                                            </dx:ASPxLabel>
&nbsp;<asp:LoginName ID="LoginName1" runat="server" />
&nbsp;<asp:LoginStatus ID="LoginStatus1" runat="server" Font-Underline="False" ForeColor="Blue" LoginText=" | Login |" 
                                                                LogoutAction="RedirectToLoginPage" LogoutText=" | Logout |" />
                                                                    &nbsp;<dx:ASPxHyperLink ID="cmdPasschange" runat="server" 
                                                                            Text=" Change Password |" />
                                                                    </td>
                                                                </tr>
                                                            </table>
                </td>
            </tr>
            <tr>
                <td>
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        <asp:UpdatePanel ID="UpdatePanel1" runat="server">
                        </asp:UpdatePanel>
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
            <tr>
                <td align="center">
                    <br />
                    <dx:ASPxImage ID="ASPxImage1" runat="server" Height="1px" 
                        ImageUrl="~/COOPERP/images/hor_line.png" Width="100%">
                    </dx:ASPxImage>
                    <br />
                    <br />
                    <dx:ASPxLabel ID="lbl_footer" runat="server" ForeColor="Blue">
                    </dx:ASPxLabel>
                </td>
            </tr>
            <tr>
                <td>
                    <dx:ASPxPopupControl ID="pop_passwordchange" runat="server" 
                        CloseAction="CloseButton" HeaderText="" Modal="True" 
                        PopupElementID="cmdPasschange" PopupHorizontalAlign="WindowCenter" 
                        PopupVerticalAlign="WindowCenter">
                        <ContentCollection>
<dx:PopupControlContentControl runat="server">
    <uc1:PasswordChanger ID="PasswordChanger1" runat="server" />
                            </dx:PopupControlContentControl>
</ContentCollection>
                    </dx:ASPxPopupControl>
                </td>
            </tr>
