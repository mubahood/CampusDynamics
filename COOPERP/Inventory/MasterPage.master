<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="OPAC_MasterPage" %>

<%@ Register Assembly="DevExpress.Web.v16.1, Version=16.1.4.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a"
    Namespace="DevExpress.Web" TagPrefix="dx" %>
<%@ Register src="../../UserControls/PasswordChanger.ascx" tagname="passwordchanger" tagprefix="uc1" %>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head id="Head1" runat="server">
    <title>Campus Dynamics ERP :: Higher Education Management Soluiton</title>
    <meta name="description" content="website description" />
    <meta name="keywords" content="Academica ERP OPAC, IUIU Library" />
    <meta http-equiv="content-type" content="text/html; charset=windows-1252" />
    <link rel="stylesheet" type="text/css" href="~/COOPERP/css/style.css" />
    <link rel="shortcut icon" href="~/COOPERP/images/tinylogo.gif" />
    <style type="text/css">
        .style1
        {
            width: 100%;
        }
        .style2
        {
            width: 300px;
            background-image: url('..images/header_1_backgrimg.png');
        }
        .backImg
        {
            background-image: url('../images/header_1_backgrimg.png');
        }
        
        .options
        {
            height: 20px;
            width: 150px;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
    <div id="main">
        <header>
	    <!--close banner-->	
	</header>
        <nav>
	  <div id="menubar">
        
      </div><!--close menubar-->	
    </nav>
        <div id="site_content">
            <table class="style1">
                <tr>
                    <td>
                <table cellspacing="0" class="style1" cellpadding="0">
                    <tr class="backImg">
                        <td class="style2">
                            <img src="../images/header_1_leftimg.png" alt="Academica ERP Library Module"/></td>
                        <td class="backImg">
                           </td>
                        <td align="right" class="style2">
                            <img src="../images/header_1_rightimg.png" alt="" /></td>
                    </tr>
                </table>
                    </td>
                </tr>
                <tr>
                    <td align="right">
        
          <dx:ASPxMenu ID="ASPxMenu1" runat="server" Width="100%" ItemImagePosition="Top">
              <Items>
                  <dx:MenuItem Name="Dashboard" Text="Dashboard" 
                      NavigateUrl="~/MyApplications.aspx">
                      <Image Url="~/COOPERP/images/application-icon.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem 
                      Text="Settings Center">
                      <Items>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=1" 
                              Text="Items Units">
                              <Image Url="~/COOPERP/images/block.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Item Groups" 
                              NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=2">
                              <Image Url="~/COOPERP/images/reports-stack.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=3" 
                              Text="Stores Management">
                              <Image Url="~/COOPERP/images/home.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=5" 
                              Text="TAX Details">
                              <Image Url="~/COOPERP/images/calculate.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/hammer-screwdriver.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Products Management">
                      <Items>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=6" 
                              Text="New Item">
                              <Image Url="~/COOPERP/images/clipboard--plus.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=12" 
                              Text="Items List">
                              <Image Url="~/COOPERP/images/clipboard-list.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/clipboard-list.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Supplier Accounts">
                      <Items>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=4" Text="Suppliers Info">
                              <Image Url="~/COOPERP/images/user-business-boss.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/SupplierLedgers.aspx" Text="Supplier Accounts">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Payments Centre">
                              <Image Url="~/COOPERP/images/money-coin.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/clipboard-invoice.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Inventory Magement">
                      <Items>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=14" 
                              Text="Local Purchase Orders (LPO)">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Goods Received Notes" 
                              NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=7" 
                              ToolTip="Goods Received Note">
                              <Image Url="~/COOPERP/images/clipboard-task.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="GRN Verification" 
                              NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=8" Visible="False">
                              <Image Url="~/COOPERP/images/tick-button.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Stock Adjustment" 
                              NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=9" Visible="False">
                              <Image Url="~/COOPERP/images/clipboard--plus.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Stock Tracking &amp; Deductions" 
                              NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=10">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=13" 
                              Text="Stock Deduction Logs">
                              <Image Url="~/COOPERP/images/clipboard--minus.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Stock Warnings" 
                              NavigateUrl="~/COOPERP/Inventory/Default.aspx?PGid=11">
                              <Image Url="~/COOPERP/images/exclamation-red.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem Text="Reports Center">
                              <Image Url="~/COOPERP/images/reports-stack.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/clipboard-list.png">
                      </Image>
                  </dx:MenuItem>
                  <dx:MenuItem Text="Department Supplies">
                      <Items>
                          <dx:MenuItem Text="Department Requisitions" NavigateUrl="~/COOPERP/Inventory/SchoolRequisitions.aspx">
                              <Image Url="~/COOPERP/images/clipboard-invoice.png">
                              </Image>
                          </dx:MenuItem>
                          <dx:MenuItem 
                              Text="Department Budgets" NavigateUrl="~/COOPERP/Inventory/SchoolBudgets.aspx">
                              <Image Url="~/COOPERP/images/clipboard-task.png">
                              </Image>
                          </dx:MenuItem>
                      </Items>
                      <Image Url="~/COOPERP/images/folder-horizontal-open.png">
                      </Image>
                  </dx:MenuItem>
              </Items>
              <SubMenuItemStyle VerticalAlign="Middle">
                  <Paddings Padding="10px" />
              </SubMenuItemStyle>
          </dx:ASPxMenu>
        
                    </td>
                </tr>
                <tr>
                    <td align="right">
	      <asp:ScriptManager ID="ScriptManager1" runat="server">
          </asp:ScriptManager>
                        <table cellspacing="1" class="style1">
                        <tr>
                            <td style="text-align: left">
                                                            <dx:ASPxLabel ID="lbl_date" runat="server" ForeColor="Red">
                                                            </dx:ASPxLabel>
                            </td>
                            <td align="right"><dx:ASPxImage ID="ASPxImage2" runat="server" ImageAlign="AbsBottom" ImageUrl="~/COOPERP/images/user.png">
                                                            </dx:ASPxImage>
&nbsp;<dx:ASPxLabel ID="ASPxLabel1" runat="server" Text="Current User:">
                                                            </dx:ASPxLabel>
&nbsp;<asp:LoginName ID="LoginName1" runat="server" />
&nbsp;<asp:LoginStatus ID="LoginStatus1" runat="server" Font-Underline="False" ForeColor="Blue" LoginText=" | Login |" 
                                                                LogoutAction="RedirectToLoginPage" LogoutText=" | Logout |" />
                                <dx:ASPxHyperLink ID="cmdPasschange" runat="server" Text="Change Password |" />
                            </td>
                        </tr>
                    </table>
                    </td>
                </tr>
                <tr>
                    <td align="right">
                        &nbsp;</td>
                </tr>
                <tr>
                    <td>
                        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                            <asp:UpdatePanel ID="UpdatePanel1" runat="server">
                            </asp:UpdatePanel>
                        </asp:ContentPlaceHolder>
                    </td>
                </tr>
                <tr>
                    <td align="center">
                        <br />
                        <dx:ASPxImage ID="ASPxImage1" runat="server" Height="1px" ImageUrl="~/COOPERP/images/hor_line.png"
                            Width="100%">
                        </dx:ASPxImage>
                        <br />
                        <br />
                        <dx:ASPxLabel ID="lbl_footer" runat="server" ForeColor="Blue">
                        </dx:ASPxLabel>
                        <br />
                        <dx:ASPxPopupControl ID="pop_passchange" runat="server" HeaderText="" 
                            Height="200px" PopupElementID="cmdPasschange" 
                            PopupHorizontalAlign="WindowCenter" PopupVerticalAlign="WindowCenter" 
                            Width="200px">
                            <ContentCollection>
<dx:PopupControlContentControl runat="server">
    <uc1:PasswordChanger ID="PasswordChanger1" runat="server" />
                                </dx:PopupControlContentControl>
</ContentCollection>
                        </dx:ASPxPopupControl>
                    </td>
                </tr>
            </table>
            <!--close sidebar_container-->
            <!--close content-->
        </div>
        <!--close site_content-->
    </div>
    <!--close main-->
    </form>
</body>
</html>
