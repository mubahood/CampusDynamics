                                                    <SettingsBehavior ConfirmDelete="True" AllowFocusedRow="True" />
                                                    <SettingsPager PageSize="50">
                                                    </SettingsPager>
                                                    <Settings ShowFilterRow="True" ShowFilterRowMenu="True" ShowFooter="True" />
                                                </dx:ASPxGridView>
                                            </td>
