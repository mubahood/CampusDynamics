# User uploaded files and generated content
# Files/*
!Files/.gitkeep
# Thumb/*
!Thumb/.gitkeep

# Temporary and cache folders
# App_Data/UploadTemp/
# App_Data/WorkDirectory/
# DXTempFolder/

# Build outputs and compiled binaries
# Bin/
# obj/
# [Dd]ebug/
# [Rr]elease/

# Visual Studio files
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# ASP.NET
project.lock.json
project.fragment.lock.json
artifacts/

# Backup files
*.bak
*.backup

# Logs
*.log
log/
logs/

# OS generated files
Thumbs.db
.DS_Store
desktop.ini

# Package files
*.nupkg
*.snupkg

# NuGet packages folder
# packages/

# Keep important folders but ignore their contents
App_Data/XtraReports/*.repx
!App_Data/XtraReports/.gitkeep

# Ignore user-generated reports
App_Data/XtraReports/*
!App_Data/XtraReports/.gitkeep

# IDE settings
.idea/
*.swp
*.swo
*~

# ============================================================
# SENSITIVE CONFIGURATION FILES
# Never commit real config files containing credentials.
# Track the sanitized *.example copies instead.
# ============================================================

# ASP.NET main config – contains DB connection strings & credentials
web.config

# Web.config environment transforms – may contain env-specific secrets
web.Debug.config
web.Release.config
web.Staging.config
web.Production.config

# Always allow the sanitized example / template versions
!web.config.example
!web.Debug.config.example
!web.Release.config.example
!web.Staging.config.example
!web.Production.config.example

# PowerShell test/helper scripts that may contain inline credentials
test_db.ps1
test_nche_queries.ps1
test_queries.ps1

# Local secrets / environment fragments
.env
.env.*
connectionStrings.local.config
appSettings.local.config
connectionStrings.*.local.config
appSettings.*.local.config
*.secrets.config
secrets.config
database/database.settings.local.json
database/imports/*.sql

# Always allow the sanitized example versions of test scripts
!test_db.ps1.example
!test_nche_queries.ps1.example
!test_queries.ps1.example
!connectionStrings.local.config.example
!appSettings.local.config.example
!database/imports/README.md
!database/database.settings.local.example.json
