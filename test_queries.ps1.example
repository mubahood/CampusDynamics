# This is a sanitized TEMPLATE of test_queries.ps1.
# It is safe to commit to source control.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file and rename to "test_queries.ps1"
# 2. Replace {{ DB_SERVER }}, {{ DB_USER }}, {{ DB_PASSWORD }}
#    with your actual database credentials
# 3. Never commit the real test_queries.ps1
#
# USAGE:
#   powershell -ExecutionPolicy Bypass -File test_queries.ps1
# ============================================================

Add-Type -AssemblyName System.Data
[System.Reflection.Assembly]::LoadWithPartialName("MySql.Data") | Out-Null

# --- CONFIGURE THESE VALUES FOR YOUR ENVIRONMENT ---
$connString = "server={{ DB_SERVER }};User Id={{ DB_USER }};password={{ DB_PASSWORD }};Persist Security Info=True;database=campus_dynamics;DefaultCommandTimeout=600"
# ----------------------------------------------------

Write-Host "Testing Campus Dynamics SQL Queries`n" -ForegroundColor Cyan

function RunQuery {
    param([string]$TestName, [string]$SQL)

    Write-Host ("=" * 50) -ForegroundColor Yellow
    Write-Host $TestName   -ForegroundColor Cyan
    Write-Host ("=" * 50) -ForegroundColor Yellow

    try {
        $conn = New-Object MySql.Data.MySqlClient.MySqlConnection($connString)
        $conn.Open()
        $cmd    = New-Object MySql.Data.MySqlClient.MySqlCommand($SQL, $conn)
        $reader = $cmd.ExecuteReader()

        $count = 0
        while ($reader.Read()) {
            $row = @{}
            for ($i = 0; $i -lt $reader.FieldCount; $i++) {
                $row[$reader.GetName($i)] = if ($reader.IsDBNull($i)) { "NULL" } else { $reader.GetValue($i) }
            }
            Write-Host ($row.Values -join " | ")
            $count++
        }
        $reader.Close()
        $conn.Close()
        Write-Host "-> $count row(s)" -ForegroundColor Green
    }
    catch {
        Write-Host ("Error: " + $_.Exception.Message) -ForegroundColor Red
    }
}

# ---- Queries ---------------------------------------------
RunQuery "Entry Years" @"
SELECT DISTINCT TRIM(entryyear) AS entryyear
FROM acad_student
WHERE entryyear IS NOT NULL AND TRIM(entryyear) != ''
ORDER BY entryyear DESC LIMIT 10
"@

RunQuery "Programmes" @"
SELECT TRIM(progcode) AS progcode, TRIM(progname) AS progname
FROM acad_programme
WHERE TRIM(progcode) != ''
ORDER BY progname LIMIT 10
"@

RunQuery "Students by Programme" @"
SELECT p.progname, COUNT(s.regno) AS total
FROM acad_student s
LEFT JOIN acad_programme p ON s.progid = p.progcode
GROUP BY p.progname
ORDER BY total DESC LIMIT 10
"@

Write-Host "`nDone: $(Get-Date)" -ForegroundColor Yellow
