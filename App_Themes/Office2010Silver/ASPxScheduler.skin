<dxwschs:ASPxScheduler runat="server">
	<Styles CssFilePath="~/App_Themes/Office2010Silver/{0}/styles.css" CssPostfix="Office2010Silver" 
		SelectionColor="#e2ecf7">
		<ResourceNavigator ButtonSpacing="0px" />
		<ViewNavigator ButtonSpacing="3px" />
		<PopupForm>
            <Content Paddings-PaddingBottom="10px" />
        </PopupForm>
        <LoadingPanel ImageSpacing="5" />
	</Styles>
	<Images SpriteCssFilePath="~/App_Themes/Office2010Silver/{0}/sprite.css">
	    <LoadingPanel Url="~/App_Themes/Office2010Silver/Scheduler/Loading.gif" />
	</Images>
</dxwschs:ASPxScheduler>

